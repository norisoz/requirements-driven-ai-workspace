            "BLOCKED",
            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P08": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P09": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P10": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P11": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P12": {
