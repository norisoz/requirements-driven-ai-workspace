            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P06": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "BLOCKED",
            "IN_REVIEW",
            "APPROVED",
            "REOPENED"
          ]
        },
        "P07": {
          "enum": [
            "NOT_STARTED",
