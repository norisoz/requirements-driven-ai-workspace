{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/req-agent/phase/P10.schema.json",
  "title": "P10 運用・監視",
  "type": "object",
  "required": [
    "monitoring_targets",
    "metrics_and_methods",
    "monitoring_owner",
    "evidence_policy",
    "escalation_and_response"
