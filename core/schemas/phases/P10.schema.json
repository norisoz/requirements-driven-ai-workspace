        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "metrics_and_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "monitoring_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_policy": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "escalation_and_response": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ai_quality_monitoring": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "sensitive_data_monitoring": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "assurance_case": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
