{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/req-agent/phase/P06.schema.json",
  "title": "P06 モデリング",
  "type": "object",
  "required": [
    "model_scope",
    "models",
    "nodes_and_relationships",
    "requirement_links",
    "model_review"
  ],
  "properties": {
    "model_scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "nodes_and_relationships": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "requirement_links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "model_review": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ai_model_boundary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "compliance_mapping": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
