{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/req-agent/phase/P02.schema.json",
  "title": "P02 ステークホルダー特定",
  "type": "object",
  "required": [
    "stakeholders",
    "roles",
    "decision_owner",
    "constraints",
    "context_alignment"
  ],
  "properties": {
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "decision_owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "context_alignment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ai_reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "data_controller": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
