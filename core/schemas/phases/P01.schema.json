{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/req-agent/phase/P01.schema.json",
  "title": "P01 目的・ミッション確認",
  "type": "object",
  "required": [
    "objective",
    "problem",
    "target_value",
    "beneficiaries",
    "scope",
    "success_criteria",
    "risks"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target_value": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "quantitative_metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "regulatory_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "simplification_review": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
