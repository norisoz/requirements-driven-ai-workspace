      {
        "field_id": "beneficiaries",
        "requirement": "REQUIRED",
        "value_type": "str_list",
        "question": "利益を受ける人や組織は誰ですか。",
        "source_class": "DESIGN_DERIVED_FROM_IPA"
      },
      {
        "field_id": "scope",
        "requirement": "REQUIRED",
        "value_type": "string",
        "question": "対象の組織、業務、適用範囲はどこまでですか。",
        "source_class": "DESIGN_DERIVED_FROM_IPA"
      },
      {
        "field_id": "success_criteria",
        "requirement": "REQUIRED",
        "value_type": "str_list",
        "question": "何を確認できれば成功と判断しますか。",
        "source_class": "DESIGN_DERIVED_FROM_IPA"
