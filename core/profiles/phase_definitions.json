      {
        "field_id": "regulatory_constraints",
        "requirement": "CONDITIONAL",
        "value_type": "str_list",
        "question": "対象となる法令、標準、契約上の制約は何ですか。",
        "source_class": "DESIGN_DERIVED_FROM_IPA",
        "when": {
          "attribute": "has_external_obligations",
          "equals": true
