      "7.2.1",
      "第16章"
    ],
    "fields": [
      {
        "field_id": "objective",
        "requirement": "REQUIRED",
        "value_type": "string",
        "question": "最終的に何を実現したいですか。手段ではなく到達状態を教えてください。",
        "source_class": "DESIGN_DERIVED_FROM_IPA"
      },
      {
        "field_id": "problem",
        "requirement": "REQUIRED",
        "value_type": "string",
        "question": "現在、誰にどのような問題が生じていますか。",
