      },
      {
        "field_id": "out_of_scope",
        "requirement": "OPTIONAL",
        "value_type": "str_list",
        "question": "今回は対象外にする業務はありますか。",
        "source_class": "DESIGN_DERIVED_FROM_IPA"
      },
      {
        "field_id": "simplification_review",
        "requirement": "OPTIONAL",
        "value_type": "str_list",
        "question": "所与の条件（既存業務手順・承認・帳票・社内規則）のうち、目的に照らして不要・簡素化できるものはありますか。（ハンドブック1.4節）",
        "source_class": "DESIGN_DERIVED_FROM_IPA"
